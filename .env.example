# Copy to .env.local (git-ignored).
# Server-side only: npm run db:setup / db:status. Supabase > Connect > Session pooler. URL-encode special characters (@ becomes %40).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Browser: project URL and publishable key (safe to expose; row-level security applies). NEXT_PUBLIC_ names also work.
VITE_SUPABASE_URL=https://cgwgmzpcrvimoqaxgoop.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_syH4-vQmxT4TL7ZJC9piaQ_Tp1LPPMD
# Password of the seeded demo staff logins (Sample brokerage only), so "Demo as ..." signs in to Supabase Auth.
VITE_DEMO_STAFF_PASSWORD=
# Broker modules that read and write Supabase instead of browser storage: all (default), none, or a comma list of
# copilot,personal,commercial,benefits,controls,funds,specialist,onboarding
VITE_SUPABASE_MODULES=all
# fal for Ava's intake wording (fal-ai Edge Function): fal, or empty for the deterministic adapter only.
VITE_ASSISTANT_ADAPTER=

# fal keys are server-side only; never give them a VITE_ prefix.
# BCOVERED_FAL_API_KEY (fal API preset) is a Supabase Edge Function secret and a Vercel variable, not set here.
# Full-access fal key for local scripts (pricing, billing events, key management). Never deploy it.
BCOVERED_LOCAL_FAL_API_KEY=
